# .gitattributes - What The Diff (WTD) Configuration
# =================================================
# Marks files/directories as generated or vendored to exclude from AI-powered PR summaries.
# This reduces token consumption and focuses WTD analysis on meaningful code changes.
#
# Reference: docs/WTD-RUNBOOK.md
# Last Updated: 2025-11-06

# Lock Files
# =================================================
# Dependency lock files are auto-generated and don't provide review value
poetry.lock linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
Pipfile.lock linguist-generated=true

# Benchmark Datasets
# =================================================
# Large static datasets downloaded separately, not meaningful for code review
data/benchmarks/** linguist-generated=true
data/readoc/** linguist-generated=true
data/doclaynet/** linguist-generated=true
data/pubtables/** linguist-generated=true
data/wind_docs/** linguist-generated=true
data/benchmarks_unsorted/** linguist-generated=true
data/test_pdfs/** linguist-generated=true

# Test Results and Outputs
# =================================================
# Generated test outputs and benchmark results
test_output/** linguist-generated=true
test_results/** linguist-generated=true
results/** linguist-generated=true
benchmark_results/** linguist-generated=true
evaluation_results/** linguist-generated=true
test_output.txt linguist-generated=true

# Build Artifacts and Distribution
# =================================================
# Compiled and distributed code
dist/** linguist-generated=true
build/** linguist-generated=true
out/** linguist-generated=true
*.egg-info/** linguist-generated=true

# Coverage Reports
# =================================================
