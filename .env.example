# Data Ingestor Environment Configuration

# ============================================
# Marker LLM Configuration (POC - Free Tier)
# ============================================

# Enable LLM-enhanced PDF extraction
# Set to 'true' to enable, 'false' to use basic Marker (no LLM)
MARKER_USE_LLM=false

# OpenRouter API Key (shared with zen-mcp-server)
# Get your key from: https://openrouter.ai/
# This is the same key used by your zen-mcp-server
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model Configuration with Smart Fallback
# ============================================
# Primary Model: Free tier (tries this first)
# Recommended: meta-llama/llama-4-maverick:free (best free vision model)
#
# Alternative free models:
#   - meta-llama/llama-4-scout:free (good quality, slightly slower)
#   - meta-llama/llama-3.1-405b-instruct:free (older model, still good)
#
# Note: Free tier models have zero cost but may have rate limits or availability issues
MARKER_LLM_MODEL=meta-llama/llama-4-maverick:free

# Fallback Model: Paid tier (automatic fallback if primary fails)
# Recommended: google/gemini-2.5-flash-lite (best value, $0.03/1M tokens)
#
# Alternative paid models:
#   - google/gemini-2.5-flash (premium quality, $0.075/1M tokens)
#   - google/gemini-2.0-flash-001 (good quality, $0.075/1M tokens)
#
# Note: Fallback is only used if primary model has API issues (connection, rate limit, etc.)
MARKER_LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Enable Automatic Fallback
# Set to 'true' to automatically fallback to paid model if free model fails
# Set to 'false' to disable fallback (will fail if primary model unavailable)
# Default: true (recommended for production reliability)
MARKER_ENABLE_FALLBACK=true

# ============================================
# Future Configuration (Not Yet Implemented)
# ============================================

# Automatic model selection based on document complexity
# MARKER_ENABLE_COMPLEXITY_ROUTING=false

# Upgrade to paid models for complex documents
# MARKER_UPGRADE_ON_COMPLEXITY=false

# Cost controls (for paid models)
# MARKER_MAX_COST_PER_DOCUMENT=0.10
# MARKER_DAILY_COST_LIMIT=10.00

# High-quality math extraction (slower, more accurate)
# MARKER_REDO_INLINE_MATH=false

# Custom block correction prompt
# MARKER_BLOCK_CORRECTION_PROMPT=""
